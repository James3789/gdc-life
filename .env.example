# ─────────────────────────────────────────────
# GDC Life - 환경변수 예시 (복사해서 .env 로 사용)
#   npm run setup  실행 시 자동으로 복사된다
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# 클라우드 프로젝트: Dashboard → Project Settings → Data API
# 로컬 스택(npm run db:start): 실행 후 출력되는 API URL / anon key 사용
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Kakao ─────────────────────────────────────
# JavaScript 키: 브라우저 지도 SDK (공개되어도 되는 값, 도메인 등록으로 보호)
VITE_KAKAO_JS_KEY=

# REST API 키: 길찾기 API 호출용. 절대 브라우저로 나가면 안 된다.
#   - 로컬  : npm run db:start 시 Edge Function 이 이 값을 읽는다
#   - 배포  : npx supabase secrets set KAKAO_REST_KEY=...
#   - tools/geocode-company.mjs 도 이 값을 사용한다
KAKAO_REST_KEY=

# ── 로컬 테스트 전용 (선택) ────────────────────
# npm run test:ratings 의 자동 완료 검증에만 쓰인다.
# VITE_ 접두사가 없어 프론트 번들에는 포함되지 않는다. 운영 키를 넣지 말 것.
# 값은 `npx supabase status` 의 SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# 회사(GDC) 좌표와 매칭 파라미터는 여기가 아니라
# DB의 app_settings 테이블에 있다 (Supabase 대시보드에서 수정 가능).
#   - company_name / company_addr / company_lat / company_lng
#   - match_radius_m / match_default_tolerance_min
#   - require_company_email / company_email_domains
# 정확한 좌표는 `npm run geocode` 로 얻는다.
# ─────────────────────────────────────────────
