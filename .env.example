# ─────────────────────────────────────────────
# GDC Life - 환경변수 예시 (복사해서 .env 로 사용)
#   cp .env.example .env
# ─────────────────────────────────────────────

# ── 서버 ──────────────────────────────────────
FLASK_ENV=development
PORT=5000
# JWT 서명 키 (운영에서는 반드시 랜덤 값으로 교체)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# ── DB ────────────────────────────────────────
# 개발: SQLite / 운영: postgresql+psycopg://user:pw@host:5432/gdclife
DATABASE_URL=sqlite:///gdclife.db

# ── CORS (프론트 개발 서버) ────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 회사(GDC) 위치 ─────────────────────────────
# HD현대마린솔루션 글로벌디지털센터(GDC)
# 아래 위경도는 도로(신두왕로) 기준 근사값입니다.
# KAKAO_REST_KEY 입력 후 아래 명령으로 정확한 건물 좌표를 얻어 교체하세요:
#   python backend/scripts/geocode_company.py
COMPANY_NAME=HD현대마린솔루션 글로벌디지털센터
COMPANY_ADDR=울산광역시 남구 신두왕로 50
COMPANY_LAT=35.51809
COMPANY_LNG=129.28832

# ── 매칭 파라미터 ─────────────────────────────
# 탑승 위치가 봉사자 경로로부터 이 거리(m) 이내면 후보로 인정
MATCH_RADIUS_M=1000
# 기본 시간 허용 오차(분)
MATCH_DEFAULT_TOLERANCE_MIN=10

# ── 사내 이메일 도메인 검증 (기본 off) ─────────
REQUIRE_COMPANY_EMAIL=false
COMPANY_EMAIL_DOMAINS=hd.com,hdmarinesolution.com

# ── Kakao ─────────────────────────────────────
# REST API 키: 서버에서 길찾기(Directions) 호출용
KAKAO_REST_KEY=
# JavaScript 키: 브라우저 지도 SDK용 (VITE_ 접두사 필수)
VITE_KAKAO_JS_KEY=

# ── 프론트 → 백엔드 주소 ───────────────────────
# 개발 중에는 Vite proxy(/api)를 쓰므로 무시된다. 프로덕션 빌드에만 사용.
VITE_API_BASE=
